{{!
    @template local_bridge/shell

    Displays the main Bridge application shell.

    Context variables required for this template:
    * sesskey - Moodle session key.
    * version - Plugin version.
    * avatarinitial - Initial displayed in the user avatar.
    * username - Current user's username.
    * strings - Localised strings used by the template.

    Example context (json):
    {
        "sesskey": "example-sesskey",
        "version": "0.3.23",
        "avatarinitial": "A",
        "username": "Admin User",
        "strings": {
            "pluginname": "Bridge",
            "coreedition": "Core",
            "overview": "Overview",
            "automations": "Automations",
            "executions": "Executions",
            "settings": "Settings",
            "productinformation": "Product information",
            "administrator": "Administrator",
            "opennavigation": "Open navigation"
        }
    }
}}

<div class="local_bridge-app" data-local_bridge-app data-sesskey="{{sesskey}}">
    <aside class="local_bridge-sidebar">
        <div class="local_bridge-brand">
            <span class="local_bridge-brand-mark">B</span>
            <span class="local_bridge-brand-name">{{strings.pluginname}}</span>
            <span class="local_bridge-edition-badge"><i class="bi bi-shield-check" aria-hidden="true"></i> {{strings.coreedition}}</span>
        </div>
        <nav class="local_bridge-nav" aria-label="{{strings.pluginname}}">
            <button type="button" class="local_bridge-nav-item is-active" data-view="dashboard">
                <span class="local_bridge-nav-icon"><i class="bi bi-house-door" aria-hidden="true"></i></span>
                <b>{{strings.overview}}</b>
            </button>
            <button type="button" class="local_bridge-nav-item" data-view="automations">
                <span class="local_bridge-nav-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
                <b>{{strings.automations}}</b>
            </button>
            <button type="button" class="local_bridge-nav-item" data-view="executions">
                <span class="local_bridge-nav-icon"><i class="bi bi-clock-history" aria-hidden="true"></i></span>
                <b>{{strings.executions}}</b>
            </button>
        </nav>
        <div class="local_bridge-sidebar-settings">
            <button type="button" class="local_bridge-nav-item" data-view="settings">
                <span class="local_bridge-nav-icon"><i class="bi bi-gear" aria-hidden="true"></i></span>
                <b>{{strings.settings}}</b>
            </button>
        </div>
        <div class="local_bridge-sidebar-bottom">
            <div class="local_bridge-product-meta">
                <span class="local_bridge-product-edition">
                    <i class="bi bi-shield-check" aria-hidden="true"></i> {{strings.coreedition}}
                </span>
                <span class="local_bridge-product-version">v{{version}}</span>
            </div>
            <div class="local_bridge-user">
                <span class="local_bridge-avatar">{{avatarinitial}}</span>
                <span>
                    <b>{{username}}</b>
                    <small>{{strings.administrator}}</small>
                </span>
            </div>
        </div>
    </aside>
    <main class="local_bridge-main">
        <div class="local_bridge-mobilebar">
            <button type="button" class="local_bridge-icon-button" data-local_bridge-sidebar-toggle aria-label="{{strings.opennavigation}}">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>
            <span>{{strings.pluginname}}</span>
            <span class="local_bridge-edition-badge">
                <i class="bi bi-shield-check" aria-hidden="true"></i> {{strings.coreedition}}
            </span>
            <span class="local_bridge-mobile-version">v{{version}}</span>
        </div>
        <div class="local_bridge-content" data-local_bridge-content aria-live="polite"></div>
    </main>
    <div class="local_bridge-toast-region" data-local_bridge-toasts></div>
</div>
