{{!
    @template local_bridge/execution_rows

    Displays automation execution rows in the executions table.

    Context variables required for this template:
    * executions - List of execution records.
    * strings - Localised strings used by the template.

    Example context (json):
    {
        "__example": true,
        "executions": [
            {
                "id": 42,
                "event": "User created",
                "automation": "User created webhook",
                "status": "success",
                "statuslabel": "Success",
                "error": "",
                "code": 200,
                "attempts": 1,
                "time": "06 Sep 2026, 10:30"
            }
        ],
        "strings": {
            "nodeliveriesfound": "No deliveries found",
            "nodeliveriesdesc": "There are no delivery executions to display."
        }
    }
}}
{{#__example}}
<table>
    <tbody>
{{/__example}}

{{#executions}}
<tr class="local_bridge-click-row" data-execution-row data-action="execution" data-id="{{id}}">
    <td><span class="local_bridge-chip">{{event}}</span></td>
    <td><b>{{automation}}</b></td>
    <td>
        <span class="local_bridge-status local_bridge-status-{{status}}">
            <i></i>{{statuslabel}}
        </span>
        {{#error}}<small class="local_bridge-error">{{error}}</small>{{/error}}
    </td>
    <td><code>{{code}}</code></td>
    <td>{{attempts}}</td>
    <td>{{time}}</td>
</tr>
{{/executions}}
{{^executions}}
<tr class="local_bridge-table-empty-row" data-execution-empty-row>
    <td colspan="6">
        <div class="local_bridge-empty local_bridge-empty-compact">
            <span class="local_bridge-empty-icon">
                <i class="bi bi-inbox" aria-hidden="true"></i>
            </span>
            <h3>{{strings.nodeliveriesfound}}</h3>
            <p>{{strings.nodeliveriesdesc}}</p>
        </div>
    </td>
</tr>
{{/executions}}
{{#__example}}
    </tbody>
</table>
{{/__example}}
