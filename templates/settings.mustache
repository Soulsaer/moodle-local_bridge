{{!
    @template local_bridge/settings

    Displays the Bridge settings overview.

    Context variables required for this template:
    * strings - Localised strings used by the template.
    * eventcount - Number of supported Moodle events.

    Example context (json):
    {
        "eventcount": 12,
        "strings": {
            "settings": "Settings",
            "manageautomations": "Manage your automation settings.",
            "deliveryprocessing": "Delivery processing",
            "deliveryprocessingdesc": "Automation deliveries are processed automatically.",
            "active": "Active",
            "automaticretries": "Automatic retries",
            "automaticretriesdesc": "Failed deliveries are retried automatically.",
            "enabled": "Enabled",
            "supportedtriggers": "Supported triggers",
            "moodleeventsavailable": "Moodle events available",
            "events": "events"
        }
    }
}}

<section class="local_bridge-view">
    <div class="local_bridge-page-head">
        <div>
            <span class="local_bridge-kicker">{{strings.settings}}</span>
            <h1>{{strings.settings}}</h1>
            <p>{{strings.manageautomations}}</p>
        </div>
    </div>

    <div class="local_bridge-card local_bridge-settings-card">
        <div class="local_bridge-setting-row">
            <div>
                <b>{{strings.deliveryprocessing}}</b>
                <p>{{strings.deliveryprocessingdesc}}</p>
            </div>
            <span class="local_bridge-status local_bridge-status-success">
                <i></i>{{strings.active}}
            </span>
        </div>

        <div class="local_bridge-setting-row">
            <div>
                <b>{{strings.automaticretries}}</b>
                <p>{{strings.automaticretriesdesc}}</p>
            </div>
            <span class="local_bridge-status local_bridge-status-success">
                <i></i>{{strings.enabled}}
            </span>
        </div>

        <div class="local_bridge-setting-row">
            <div>
                <b>{{strings.supportedtriggers}}</b>
                <p>{{eventcount}} {{strings.moodleeventsavailable}}</p>
            </div>
            <span class="local_bridge-chip">
                {{eventcount}} {{strings.events}}
            </span>
        </div>
    </div>
</section>
